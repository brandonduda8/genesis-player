<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Phase 1 Apollo voice: input-only push-to-talk, requested at first mic
         use (Apollo tab). The ONLY new permission in this release. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.GenesisPlayer"
        android:allowBackup="true"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlayerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- OACP v0.3: capability discovery for voice assistants (Alliance verdict 2026-10-05).
             Authority must end in .oacp; serves /manifest (oacp.json) and /context (OACP.md). -->
        <provider
            android:name=".oacp.OacpMetadataProvider"
            android:authorities="com.apexforge.genesisplayer.oacp"
            android:exported="true" />

        <!-- OACP v0.3: playback action endpoint. Playback-only (sensitivity low). -->
        <receiver
            android:name=".oacp.OacpActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.apexforge.genesisplayer.oacp.ACTION_RESUME" />
                <action android:name="com.apexforge.genesisplayer.oacp.ACTION_PAUSE" />
                <action android:name="com.apexforge.genesisplayer.oacp.ACTION_NEXT" />
                <action android:name="com.apexforge.genesisplayer.oacp.ACTION_PREVIOUS" />
                <action android:name="com.apexforge.genesisplayer.oacp.ACTION_PLAY_QUERY" />
                <action android:name="com.apexforge.genesisplayer.oacp.ACTION_NOW_PLAYING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
