<?xml version="1.0" encoding="utf-8"?>
<!-- AURUM mark (original): a molten-gold vault ring, an inner pulse ring, the "A" apex rising through it, and an
     ember core where the crossbar would be. Everything sits inside the 66dp adaptive safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <!-- soft glow -->
    <path android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="30"
                android:startColor="#33F5B942" android:endColor="#00F5B942" />
        </aapt:attr>
    </path>
    <!-- vault ring -->
    <path android:pathData="M54,54m-27,0a27,27 0,1 1,54 0a27,27 0,1 1,-54 0" android:strokeWidth="3.2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="30" android:startY="28" android:endX="80" android:endY="82"
                android:startColor="#FFFFD77A" android:centerColor="#FFF5B942" android:endColor="#FFFF7A2F" />
        </aapt:attr>
    </path>
    <!-- pulse ring -->
    <path android:pathData="M54,54m-19,0a19,19 0,1 1,38 0a19,19 0,1 1,-38 0" android:strokeWidth="1.4"
        android:strokeColor="#80F5B942" android:fillColor="#00000000" />
    <!-- the A apex -->
    <path android:pathData="M44,67 L54,40 L64,67" android:strokeWidth="4" android:strokeLineCap="round"
        android:strokeLineJoin="round" android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="54" android:startY="40" android:endX="54" android:endY="67"
                android:startColor="#FFFFE29A" android:endColor="#FFF5B942" />
        </aapt:attr>
    </path>
    <!-- ember core -->
    <path android:pathData="M54,58.5m-3.8,0a3.8,3.8 0,1 1,7.6 0a3.8,3.8 0,1 1,-7.6 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="57.5" android:gradientRadius="4.2"
                android:startColor="#FFFFE29A" android:endColor="#FFFF7A2F" />
        </aapt:attr>
    </path>
</vector>
